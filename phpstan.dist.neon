includes:
  - vendor/phpstan/phpstan-symfony/extension.neon

parameters:
  # Raise progressively to level 8 during V4
  level: 6
  paths:
    - src
    - tests
  # The bridge with entity-translate is analysed again once entity-translate-bundle is added to require-dev.
  excludePaths:
    analyse:
      - src/Bridge/EntityTranslate
  tmpDir: var/phpstan
