{
    "name": "austral/entity-file-bundle",
    "type": "symfony-bundle",
    "description": "File uploads, thumbnails and download for entity to Symfony. Compress file with squoosh-cli",
    "keywords": [
        "Austral",
        "File entity",
        "Files entities",
        "Uploads"
    ],
    "license": "MIT",
    "homepage": "https://austral.dev",
    "authors": [
        {
            "name": "Matthieu Beurel",
            "email": "matthieu@austral.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2 <9.0",
        "austral/contracts": "^4.0",
        "austral/tools-bundle": "^4.0",
        "austral/entity-bundle": "^4.0",
        "symfony/config": "^7.4",
        "symfony/http-client": "^7.4",
        "imagine/imagine": "^1.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "suggest": {
        "austral/entity-translate-bundle": "Translation of files attached to translated entities"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Austral\\EntityFileBundle\\": ""
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
