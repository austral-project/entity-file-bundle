{
  "name": "austral/entity-file-bundle",
  "type": "symfony-bundle",
  "description": "File uploads, thumbnails and download for entity to Symfony. Compress file with squoosh-cli",
  "keywords": [
    "Austral",
    "File entity",
    "Files entities",
    "Uploads"
  ],
  "license": "MIT",
  "homepage": "https://austral.dev",
  "authors": [
    {
      "name": "Matthieu Beurel",
      "email": "matthieu@austral.dev",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.4 <9.0",
    "ext-fileinfo": "*",
    "austral/contracts": "^4.0",
    "austral/entity-bundle": "^4.0",
    "austral/tools-bundle": "^4.0",
    "doctrine/collections": "^2.2 || ^3.1",
    "doctrine/orm": "^3.7",
    "doctrine/persistence": "^3.3 || ^4.0",
    "imagine/imagine": "^1.3",
    "symfony/config": "^7.4",
    "symfony/console": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/filesystem": "^7.4",
    "symfony/form": "^7.4",
    "symfony/html-sanitizer": "^7.4",
    "symfony/http-client": "^7.4",
    "symfony/http-client-contracts": "^3.5",
    "symfony/http-foundation": "^7.4",
    "symfony/http-kernel": "^7.4",
    "symfony/mime": "^7.4",
    "symfony/process": "^7.4",
    "symfony/routing": "^7.4",
    "symfony/string": "^7.4",
    "symfony/validator": "^7.4",
    "twig/twig": "^3.21"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "austral/admin-bundle": "Configuration checks of the uploads in the Austral administration (src/Bridge/Admin)",
    "austral/entity-translate-bundle": "Translation of files attached to translated entities (src/Bridge/EntityTranslate)",
    "austral/form-bundle": "Upload fields in Austral forms (src/Bridge/Form)",
    "ext-exif": "Reads the EXIF metadata of uploaded JPEG images"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Austral\\EntityFileBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Austral\\EntityFileBundle\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
